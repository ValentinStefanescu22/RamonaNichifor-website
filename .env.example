# Copy to .env.local (never committed) and fill in.
PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URI=postgres://localhost:5432/ramona
# Neon (written by `neon deploy` / `neon env pull`). The app uses DATABASE_URL (pooled) only when
# DATABASE_URI is unset; migrations, pg_dump and pg_restore use DATABASE_URL_UNPOOLED (direct).
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=
# Canonical site URL; leave unset locally (defaults to https://ramonanichifor.com)
# NEXT_PUBLIC_SITE_URL=
# Secret shared by the admin's Live Preview and /api/preview
PREVIEW_SECRET=change-me-too
# Developer admin created by `npm run seed` (local test account only)
SEED_ADMIN_EMAIL=dev@example.test
SEED_ADMIN_PASSWORD=change-me
# Cloudflare R2 (S3-compatible), for uploads and backups/. Leave empty to keep uploads on local disk in media/.
# The bucket must stay private (no public r2.dev URL): it holds the database dumps.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1 only on the launched site: previews stay noindex
SITE_INDEXABLE=
# Contact form (spec §5.8): Resend sends the mail; Turnstile guards the form. Tests use Turnstile's published test keys
# and CONTACT_TRANSPORT=log (playwright.config.ts), which writes the mail to reports/mail/ instead of sending it.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
