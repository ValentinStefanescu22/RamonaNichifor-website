  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "node --test --experimental-strip-types tests/unit/stamp.test.ts tests/unit/sessions.test.ts tests/unit/contact.test.ts tests/unit/seed-media.test.ts && payload run tests/unit/media-upload.ts && payload run tests/unit/content.ts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "check:copy": "! grep -rIn -e 'Bine ai revenit acasă' -e 'Welcome home' app components content messages lib",
    "payload": "payload",
    "seed": "payload run payload/seed/index.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@neon/config": "^1.9.4",
