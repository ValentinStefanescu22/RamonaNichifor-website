    "@payloadcms/next": "^3.92.0",
    "@payloadcms/richtext-lexical": "^3.92.0",
    "@payloadcms/storage-s3": "^3.92.0",
    "@payloadcms/translations": "^3.92.0",
    "graphql": "^16.14.2",
    "motion": "^12.43.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "payload": "^3.92.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
