    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9"
  }
