{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3000"],
      "port": 3000
    },
    {
      "name": "site-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "npm run build && exec npx next start -p 3100"],
      "port": 3100
    },
    {
      "name": "mockups-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd mockups && exec npx vite --port 5173 --strictPort"],
      "port": 5173
    },
    {
      "name": "mockups-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd mockups && exec npx vite preview --port 4173 --strictPort"],
      "port": 4173
    }
  ]
}
