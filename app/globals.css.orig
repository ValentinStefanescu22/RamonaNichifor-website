@import "tailwindcss" source(none);
@source "../app";
@source "../components";

/* Poiana design system (DESIGN.md). Ported from mockups/src/shared/base.css + mockups/src/poiana/tokens.css. */
/* Shared behaviour for every page. Colours always come from the page's own tokens. */
:root {
  color-scheme: light;
  -webkit-text-size-adjust: 100%;
  text-rendering: optimizeLegibility;
}
html {
  scroll-behavior: smooth;
}
body {
  margin: 0;
  min-height: 100%;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
  overflow-x: clip;
}
h1, h2, h3 {
  text-wrap: balance;
}
p {
  text-wrap: pretty;
}
img {
  max-width: 100%;
}
:focus-visible {
  outline: 2px solid var(--focus, currentColor);
  outline-offset: 3px;
}
button {
  cursor: pointer;
  -webkit-user-select: none;
  user-select: none;
}

/* The flapping butterfly */
.butterfly {
  display: flex;
  align-items: flex-start;
  perspective: 900px;
  transform-style: preserve-3d;
  pointer-events: none;
}
.butterfly .wing {
  display: block;
  height: auto;
  max-width: none;
  backface-visibility: visible;
  will-change: transform;
}
.butterfly .wing-l { width: 43.4%; transform-origin: 100% 52%; }
.butterfly .wing-r { width: 56.6%; transform-origin: 0% 52%; }
.butterfly[data-flap="on"] .wing-l { animation: wing-l var(--flap-tempo, 0.34s) cubic-bezier(0.45, 0.05, 0.35, 1) infinite alternate; }
.butterfly[data-flap="on"] .wing-r { animation: wing-r var(--flap-tempo, 0.34s) cubic-bezier(0.45, 0.05, 0.35, 1) infinite alternate; }
.butterfly[data-flap="off"] .wing-l { transform: rotateY(18deg); transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
.butterfly[data-flap="off"] .wing-r { transform: rotateY(-18deg); transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
@media (prefers-reduced-motion: reduce) {
  .butterfly .wing-l { animation: none !important; transform: rotateY(18deg); }
  .butterfly .wing-r { animation: none !important; transform: rotateY(-18deg); }
}
@keyframes wing-l { from { transform: rotateY(6deg); } to { transform: rotateY(66deg); } }
@keyframes wing-r { from { transform: rotateY(-6deg); } to { transform: rotateY(-66deg); } }

/* Buburuza settled on a flower: a slow rock on her feet, transform only */
.ladybird { transform-origin: 50% 92%; }
/* a profile butterfly gliding: a slow rise and a tilt, transform only */
@keyframes glide { 0%, 100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(-6px) rotate(4deg); } }
@keyframes sway { 0%, 100% { transform: rotate(-2.5deg); } 50% { transform: rotate(2.5deg); } }

/* Her illustrations (img.art): no drag, no long-press „Save image” on phones, not printed.
   Screenshots can't be blocked on the web; the © stamp in each image does that job. */
img.art {
  -webkit-user-drag: none;
  -webkit-touch-callout: none;
  user-select: none;
}
@media print {
  img.art { visibility: hidden; }
}

/* Language switch cross-fade */
::view-transition-old(root),
::view-transition-new(root) {
  animation-duration: 0.28s;
  animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Poiana: the page is the meadow from her cover. Sky at the top, flowers at the bottom,
   plum ink in between. One committed light world (no dark variant by design). */
@theme {
  --color-sky: #d6e6f5;
  --color-mist: #eef3fa;
  --color-cream: #fbf7f1;
  --color-petal: #f6dde6;
  --color-lilac: #c9b8e6;
  --color-violet: #7a5fb0;
  --color-ink: #34224a;
  --color-ink-soft: #5e4a75;
  --color-magenta: #b8468a;
  --color-sage: #dfe7d4;
  --color-leaf: #6f8a5a;

  --color-paper-mat: #fffdf9;

  --font-display: var(--font-fraunces), "Iowan Old Style", "Palatino Linotype", Georgia, serif;
  --font-sans: var(--font-alegreya), "Gill Sans", "Segoe UI", system-ui, sans-serif;
  /* Her hand: only the wordmark and the signature, never running text */
  --font-script: var(--font-parisienne), "Snell Roundhand", "Apple Chancery", cursive;

  --ease-bloom: cubic-bezier(0.16, 1, 0.3, 1);
}

:root {
  --focus: var(--color-magenta);
  --toggle-bg: color-mix(in oklab, var(--color-cream) 70%, transparent);
  --toggle-ink: var(--color-ink-soft);
  --toggle-thumb: var(--color-ink);
  --toggle-thumb-ink: var(--color-cream);
}

body {
  background: var(--color-cream);
  color: var(--color-ink);
  font-family: var(--font-sans);
  font-size: 1.0625rem;
  line-height: 1.6;
}

::selection {
  background: var(--color-petal);
  color: var(--color-ink);
}

.display {
  font-family: var(--font-display);
  font-variation-settings: "SOFT" 100, "WONK" 0;
  font-optical-sizing: auto;
  letter-spacing: -0.02em;
  line-height: 1;
}
.display-wonk {
  font-variation-settings: "SOFT" 100, "WONK" 1;
}

/* A soft paint edge for arched windows and washes */
.paint-edge {
  filter: url(#paint-edge);
}

/* Horizontal snap row for universes on phones */
.snap-row {
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  overscroll-behavior-x: contain;
}
.snap-row::-webkit-scrollbar {
  display: none;
}
.snap-row > * {
  scroll-snap-align: center;
}

.arch {
  border-radius: 999px 999px 1.75rem 1.75rem;
}

.shadow-soft {
  box-shadow:
    0 1px 2px rgb(52 34 74 / 0.06),
    0 18px 40px -18px rgb(52 34 74 / 0.28);
}
.shadow-book {
  box-shadow:
    0 2px 4px rgb(52 34 74 / 0.08),
    0 30px 60px -24px rgb(52 34 74 / 0.45),
    inset 3px 0 6px -3px rgb(255 255 255 / 0.5);
}

@keyframes bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-7px); }
}

/* Hero entrance: CSS keyframes so it completes on time even in throttled or hidden tabs */
@keyframes rise {
  from { opacity: 0; transform: translateY(0.35em); filter: blur(10px); }
  to { opacity: 1; transform: none; filter: blur(0); }
}
@keyframes fade-up {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: none; }
}
@keyframes bloom-in {
  from { opacity: 0; transform: scale(0.55); }
  to { opacity: 0.85; transform: scale(1); }
}
@keyframes fade-to {
  from { opacity: 0; }
}
@keyframes meadow-in {
  from { opacity: 0; filter: blur(8px); transform: translateY(24px); }
  to { opacity: 1; filter: blur(0); transform: none; }
}
.rise { animation: rise 1.1s var(--ease-bloom) var(--d, 0s) both; }
.fade-up { animation: fade-up 0.9s var(--ease-bloom) var(--d, 0s) both; }
.bloom-in { opacity: 0.85; animation: bloom-in 1.8s var(--ease-bloom) 0.1s both; }
.wash-in { opacity: 0.75; animation: fade-to 1.4s var(--ease-bloom) both; }
.meadow-in { animation: meadow-in 1.2s var(--ease-bloom) 0.1s both; }
